LONG_AGENT_API_KEY=replace_with_your_api_key
LONG_AGENT_BASE_URL=https://api.openai.com/v1
LONG_AGENT_MODEL=gpt-4.1-mini
LONG_AGENT_TIMEOUT=60
LONG_AGENT_TEMPERATURE=0.1
# auto enables thinking for DeepSeek endpoints/models and leaves it off elsewhere.
LONG_AGENT_THINKING=auto
LONG_AGENT_REASONING_EFFORT=high
LONG_AGENT_PROVIDER_MAX_ATTEMPTS=3
LONG_AGENT_CONTEXT_WINDOW_TOKENS=128000
# Optional: set current model prices per 1M tokens to enable cost estimates.
# LONG_AGENT_TOKEN_PRICES_JSON={"gpt-4.1-mini":{"input_per_1m":0.0,"output_per_1m":0.0,"currency":"USD"}}
